{
  "version": "v1",
  "hooks": [
    {
      "name": "Check Taruvi Setup",
      "description": "When explicitly asked, verify both Taruvi config outputs: MCP config and app .env.",
      "trigger": "UserPromptSubmit",
      "matcher": "\\b([Cc][Hh][Ee][Cc][Kk]|[Vv][Ee][Rr][Ii][Ff][Yy])\\s+[Tt][Aa][Rr][Uu][Vv][Ii]\\s+[Ss][Ee][Tt][Uu][Pp]\\b",
      "action": {
        "type": "command",
        "command": "python3 .kiro/scripts/check-taruvi-setup.py"
      },
      "timeout": 30
    }
  ]
}
