{
  "mcpServers": {
    "taruvi": {
      "type": "http",
      "url": "https://${user_config.taruvi_tenant}.taruvi.cloud/mcp/",
      "headers": {
        "Authorization": "Api-Key ${user_config.taruvi_api_key}",
        "X-App-Slug": "${user_config.taruvi_app_slug}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${user_config.context7_api_key}"
      }
    }
  }
}
