{
  "mcpServers": {
    "taruvi": {
      "url": "https://${TARUVI_TENANT}.taruvi.cloud/mcp/",
      "headers": {
        "Authorization": "Api-Key ${TARUVI_API_KEY}",
        "X-App-Slug": "${TARUVI_APP_SLUG}"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    }
  }
}
